[Desktop Entry]
Type=Application

Name=VertexNote
GenericName=Note-taking application
Comment=Take CAD-inspired technical notes
Keywords=tablet;Wacom;pen input;PDF Annotation;markup;journal;handwriting;diary;notes;

Exec=vertex-note-wrapper %f
SingleMainWindow=false
StartupWMClass=app.vertexnote.VertexNote
Terminal=false
StartupNotify=true
MimeType=application/x-xoj;application/x-xojpp;application/x-xopp;application/x-xopt;application/pdf
Icon=app.vertexnote.VertexNote
Categories=Office;GNOME;GTK
